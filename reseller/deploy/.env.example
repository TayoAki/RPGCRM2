# Copy per customer with reseller/deploy/new-instance.sh, which fills in the secrets.

# Public hostname of this instance; Caddy requests its TLS certificate.
DOMAIN=crm.example.com

IMAGE=ghcr.io/tayoaki/rpgcrm2
TAG=latest

# openssl rand -hex 32 (no special characters: it is embedded in a URL)
PG_DATABASE_PASSWORD=
# openssl rand -base64 32
ENCRYPTION_KEY=

# --- Branding (all optional except BRAND_NAME) ---------------------------
BRAND_NAME=RPG CRM
BRAND_LOGO_URL=
BRAND_WEBSITE_URL=
BRAND_SUPPORT_URL=
BRAND_DOCUMENTATION_URL=
BRAND_TERMS_OF_SERVICE_URL=
BRAND_PRIVACY_POLICY_URL=
BRAND_LEGAL_ENTITY=
# Leave empty to serve the source archive bundled in the image at /source-code.
SOURCE_CODE_URL=

# --- Outgoing email (invites, password resets) ----------------------------
# logger only prints emails to the server log; use smtp in production.
EMAIL_DRIVER=logger
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=RPG CRM
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=

# --- File storage ---------------------------------------------------------
# local keeps uploads in a Docker volume; use s3 for anything you cannot lose.
STORAGE_TYPE=local
STORAGE_S3_REGION=
STORAGE_S3_NAME=
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=

# --- Google / Microsoft sign-in, mail and calendar sync ---------------------
AUTH_GOOGLE_ENABLED=false
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_MICROSOFT_ENABLED=false
AUTH_MICROSOFT_CLIENT_ID=
AUTH_MICROSOFT_CLIENT_SECRET=

# true: one instance hosts many workspaces on <workspace>.DOMAIN subdomains
# (needs a wildcard DNS record and certificate). false: one workspace per instance.
IS_MULTIWORKSPACE_ENABLED=false

# Change only when running several instances on one host behind another proxy.
HTTP_PORT=80
HTTPS_PORT=443
